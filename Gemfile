source "https://rubygems.org"

ruby "~> 3.3"

# Match the Jekyll environment used by GitHub Pages.
gem "github-pages", "~> 232", group: :jekyll_plugins

# github-pages uses this release; newer Nokogiri versions require Ruby 3.
gem "nokogiri", "= 1.16.7"

# Ruby 3 no longer includes WEBrick, which Jekyll uses for local previews.
gem "webrick", "~> 1.8"
